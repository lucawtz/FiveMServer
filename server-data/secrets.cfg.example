# ============================================================================
#  secrets.cfg.example - Vorlage für server-data/secrets.cfg
# ============================================================================
#
#  So gehst du vor:
#    1. Diese Datei nach secrets.cfg kopieren (die Install-Skripte machen das
#       automatisch, wenn secrets.cfg noch nicht existiert).
#    2. Die Werte unten eintragen.
#    3. secrets.cfg NIEMALS committen, sie steht bereits in .gitignore.
#
#  server.cfg lädt diese Datei per 'exec secrets.cfg'. Alles, was hier steht,
#  überschreibt gleichnamige Einstellungen aus server.cfg und den anderen cfg-Dateien.
#
#  Kein Semikolon außerhalb von Anführungszeichen, auch nicht in Kommentaren:
#  FXServer trennt dort Befehle und führt den Rest der Zeile aus.
# ============================================================================


# ----------------------------------------------------------------------------
#  Lizenzschlüssel (Pflicht)
# ----------------------------------------------------------------------------
# Kostenlos im Cfx.re Portal erstellen:
#   https://portal.cfx.re/  ->  Servers  ->  Registration Keys  ->  "Generate Key +"
#   (nur ein Anzeigename wird abgefragt, keine IP-Bindung mehr nötig)
# Der Schlüssel sieht so aus: cfxk_xxxxxxxxxxxxxxxxxxxx_xxxxxx
#
# txAdmin: txAdmin fragt den Schlüssel NICHT ab und speichert ihn auch nicht,
# wenn du einen bestehenden Server-Ordner ("Existing Server Data") einbindest.
# Er muss in einer Datei stehen, die server.cfg ausführt, also genau hier.
#
# Die Install- und Start-Skripte erkennen den Platzhalter "changeme" und warnen.
sv_licenseKey "changeme"


# ----------------------------------------------------------------------------
#  Datenbank (PFLICHT für Qbox)
# ----------------------------------------------------------------------------
# Ohne diesen Eintrag startet oxmysql nicht und Qbox funktioniert nicht.
# Automatisch eintragen lassen:
#   Linux:   install.sh (Standard) oder sudo bash scripts/linux/setup-database.sh --create
#   Windows: scripts\windows\setup-database.bat -Create -Import
#   Docker:  wird aus MYSQL_CONNECTION_STRING in .env erzeugt
# Aufbau: mysql://BENUTZER:PASSWORT@HOST:PORT/DATENBANK?charset=utf8mb4
# Passwort nur aus A-Z, a-z und 0-9. oxmysql dekodiert keine %XX-Sequenzen, und
# Zeichen wie Semikolon, Komma, / ? : @ & = + $ # zerlegen den String.
# Nur MariaDB ab 10.9 (empfohlen 12.3 LTS), kein MySQL, kein XAMPP.
#set mysql_connection_string "mysql://fivem:PASSWORT@127.0.0.1:3306/fivem?charset=utf8mb4"

# Langsame Datenbankabfragen ab X Millisekunden in der Konsole melden.
#set mysql_slow_query_warning 150


# ----------------------------------------------------------------------------
#  RCON (optional)
# ----------------------------------------------------------------------------
# Fernsteuerung der Serverkonsole per UDP. Wenn nicht gesetzt, ist RCON aus.
# Unbedingt ein langes, zufälliges Passwort verwenden.
# Windows (PowerShell):  -join ((48..57 + 97..122) | Get-Random -Count 32 | % {[char]$_})
# Linux:                 openssl rand -hex 16
#set rcon_password "HIER_EIN_ZUFAELLIGES_PASSWORT"


# ----------------------------------------------------------------------------
#  Steam Web API Key (optional)
# ----------------------------------------------------------------------------
# Nur nötig, wenn Skripte Steam-Identifier (steam:...) brauchen.
# Key erstellen: https://steamcommunity.com/dev/apikey
#set steam_webApiKey "DEIN_STEAM_WEB_API_KEY"


# ----------------------------------------------------------------------------
#  Handy npwd: Upload-Tokens (optional)
# ----------------------------------------------------------------------------
# Ohne Token funktionieren Kamera-Fotos und Sprachnachrichten im Handy nicht,
# alles andere schon. Das Token ist der API-Schlüssel des Upload-Dienstes, den
# [vendor]/[npwd]/npwd/config.json unter "images" und "voiceMessage" nennt.
# Anleitung: https://projecterror.dev/docs/npwd/start/installation
#set SCREENSHOT_BASIC_TOKEN "DEIN_TOKEN_FUER_FOTOS"
#set NPWD_AUDIO_TOKEN "DEIN_TOKEN_FUER_SPRACHNACHRICHTEN"


# ----------------------------------------------------------------------------
#  Logging und Webhooks (optional)
# ----------------------------------------------------------------------------
# ox_lib-Logger, Anbieter und Schlüssel: https://overextended.dev/ox_lib/Modules/Logger/Server
#set ox:logger "ANBIETER"
# Webhook-URL für Bild-Metadaten in ox_inventory (ohne Eintrag aus)
#set inventory:webhook "https://..."


# ----------------------------------------------------------------------------
#  OneSync (Pflicht ab 32 Slots, für Qbox und ox_lib)
# ----------------------------------------------------------------------------
# OneSync wird absichtlich in KEINER cfg-Datei gesetzt, auch nicht hier.
# Grund: der txAdmin-CFG-Validator kommentiert 'set onesync on' in jeder
# geladenen cfg-Datei aus (auch in secrets.cfg) und verwaltet OneSync selbst
# unter Settings > FXServer (Standard "on"). Im Direkt-Modus ohne txAdmin
# übergeben die Start-Skripte OneSync als Startargument vor +exec:
#   Windows:      scripts/windows/start-direct.bat (FXServer.exe +set onesync on +exec server.cfg)
#   Linux/Docker: bash ../artifacts/run.sh +set onesync on +exec server.cfg
# Hier also KEINE onesync-Zeile eintragen.


# ----------------------------------------------------------------------------
#  Umgebungs-Überschreibungen (optional)
# ----------------------------------------------------------------------------
# Hier kannst du Werte aus server.cfg für GENAU DIESE Maschine überschreiben,
# ohne die gemeinsame server.cfg zu ändern (z. B. lokal vs. Live-Server).
#
# Anderer Hostname auf dem Live-Server:
#sv_hostname "Mein RP-Server (Live)"
#
# Beschreibung in der Serverliste mit Betreiber und Kontakt-E-Mail (Inhalte-Regeln,
# PLA §2.3, siehe docs/inhalte-regeln.md, max. 250 Zeichen, Hinweis am Ende behalten).
# Der Name im Hinweis muss sv_projectName entsprechen, keine Rockstar- oder
# FiveM-Namen und keine Lore-Marken im Servernamen:
#sets sv_projectDesc "Privater Roleplay-Server nur für Freunde. Betreiber: DEIN_NAME, Kontakt: DEINE_EMAIL. MEIN RP-PROJEKT IS NOT APPROVED, SPONSORED, OR ENDORSED BY ROCKSTAR GAMES."
#
# Andere Slot-Anzahl (ab 32 nur mit OneSync, über 48 nur mit Element Club):
#sv_maxclients 32
#
# Lokaler Test-PC: Server in der Serverliste als privat markieren und die
# Meldung "Could not contact the server browser" unterdrücken:
#sv_master1 ""
