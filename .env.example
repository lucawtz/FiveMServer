# Umgebungsvariablen fuer Docker Compose (docker/docker-compose.yml).
# Kopiere diese Datei nach .env im Projektordner und trage deine Werte ein.
# .env ist per .gitignore ausgeschlossen und darf nie committet werden.
#
# Der FXServer-Container erzeugt beim ersten Start automatisch
# server-data/secrets.cfg aus diesen Werten, falls die Datei noch nicht existiert.
# Existiert sie schon, gewinnt die Datei und die Variablen werden ignoriert.
# Werte ohne Anfuehrungszeichen eintragen. Anfuehrungszeichen, Backslash und
# Zeilenumbrueche sind in allen Werten tabu (secrets.cfg kann sie nicht abbilden).
#
# Start: docker compose --env-file .env -f docker/docker-compose.yml up -d --build

# Lizenz-Key aus dem Cfx.re Portal: https://portal.cfx.re/servers/registration-keys
FIVEM_LICENSE_KEY=changeme

# RCON-Passwort (leer lassen = RCON aus). Erzeugen z. B. mit: openssl rand -hex 16
RCON_PASSWORD=

# Optional: Steam Web API Key fuer steam:-Identifier (https://steamcommunity.com/dev/apikey)
STEAM_WEBAPI_KEY=

# MariaDB-Container (Service "db"). docker-compose.yml reicht diese Werte als MARIADB_* an das Image weiter.
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=fivem
MYSQL_USER=fivem
MYSQL_PASSWORD=changeme-fivem

# Verbindungs-String fuer oxmysql. Hostname ist der Compose-Service "db".
# Passwort muss zu MYSQL_PASSWORD passen. Sonderzeichen wie ; , / ? : @ & = + $ # vermeiden.
MYSQL_CONNECTION_STRING=mysql://fivem:changeme-fivem@db/fivem?charset=utf8mb4

# Optional: Artifact-Channel fuer den Image-Build (recommended, latest, optional). Standard: recommended
#FX_CHANNEL=recommended
