# EditorConfig: https://editorconfig.org
# Einheitliche Zeichencodierung, Zeilenenden und Einrückung für alle Editoren.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{lua,ps1}]
indent_size = 4

# PowerShell 5.1 braucht UTF-8 MIT BOM, sonst werden Umlaute falsch angezeigt.
[*.ps1]
end_of_line = crlf
charset = utf-8-bom

# Batch-Dateien: CRLF, reines ASCII (keine Umlaute), kein erzwungenes Newline am Ende.
[*.{bat,cmd}]
end_of_line = crlf
insert_final_newline = false

[Makefile]
indent_style = tab
